---
interface Props {
  path: string;
}
const { path } = Astro.props;
---

<div class="overflow-hidden rounded-md border border-border shadow-sm">
  <div class="flex items-center gap-2 border-b border-border bg-elevated px-4 py-3">
    <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
    <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
    <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
    <span class="ml-3 font-mono text-xs text-muted">{path}</span>
  </div>
  <div class="flex flex-col gap-3 bg-bg p-6 font-mono text-sm leading-relaxed">
    <slot />
  </div>
</div>
