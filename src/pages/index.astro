---
import '../styles/global.css';

const CV = '/CV_2026-08_Dorian_SAMTMANN.pdf';

const contacts = [
  { label: 'Email', value: 'dorian.samtmann@gmail.com', href: 'mailto:dorian.samtmann@gmail.com' },
  { label: 'LinkedIn', value: 'in/dorian-stm', href: 'https://www.linkedin.com/in/dorian-stm/' },
  { label: 'GitHub', value: 'dodosamtmann', href: 'https://github.com/dodosamtmann' },
  { label: 'Web', value: 'cybersmartdesign.fr', href: 'https://cybersmartdesign.fr' },
];

// `count` drives the count-up animation; `value` is what renders without JS.
const indicators = [
  { count: 2300, suffix: '+', value: '2 300+', label: 'tickets traités sur SI critique' },
  { count: 3, suffix: ' ans', value: '3 ans', label: 'en détection & réponse à incidents' },
  { count: 6, suffix: ' mois', value: '6 mois', label: 'pour livrer une préprod SIEM complète' },
  { count: 3, suffix: '', value: '3', label: 'analystes SOC juniors formés' },
];

const experience = [
  {
    period: 'Avr. → Juil. 2022',
    status: 'Clos',
    title: 'Stage de fin de DUT',
    org: 'IBM',
    place: 'Lille',
    bullets: ['Stage de 3 mois clôturant le DUT Réseaux & Télécommunications'],
    stack: [] as string[],
  },
  {
    period: '2022 → 2025',
    status: 'Clos',
    title: 'Analyste Cybersécurité',
    org: 'Pro BTP',
    place: 'Cagnes-sur-Mer',
    bullets: [
      '+2 300 tickets traités sur SI critique (secteur assurance/BTP)',
      'Use cases de détection déployés en production sur IBM QRadar',
      'Préprod SIEM complète déployée en 6 mois',
      'Formation de 3 analystes SOC juniors',
      'Réponse à incidents selon ISO 27035',
    ],
    stack: ['QRadar', 'SentinelOne', 'Netskope', 'Cisco IronPort', 'ServiceNow', 'Resilient', 'Rapid7'],
  },
  {
    period: 'Nov. 2025 → …',
    status: 'Ouvert',
    title: 'Freelance Web',
    org: 'CyberSmartDesign',
    place: 'Vence',
    bullets: [
      'Création de sites web pour TPE/PME',
      'Stack : Astro · Cloudflare Workers · TypeScript',
      "Preuve d'autonomie technique et gestion de projet solo",
    ],
    stack: ['Astro', 'Cloudflare Workers', 'TypeScript'],
  },
].map((job, i) => ({ ...job, ref: `CAS-${String(i + 1).padStart(2, '0')}` }));

const skillGroups = [
  { name: 'SIEM & Détection', items: ['QRadar', 'Wazuh', 'MITRE ATT&CK', 'ISO 27035'] },
  { name: 'Protection', items: ['SentinelOne', 'Netskope', 'Defender', 'IronPort'] },
  { name: 'SOAR & Ticketing', items: ['ServiceNow', 'IBM Resilient'] },
  { name: 'Vuln Mgmt', items: ['Rapid7'] },
  { name: 'Scripting', items: ['Python', 'PowerShell', 'Bash'] },
  { name: 'Infra', items: ['Docker', 'Cloudflare', 'Microsoft 365'] },
];

const formation = [
  { period: '2023 – 2025', degree: 'Master — Manager Infrastructures & Cybersécurité des SI', school: 'CESI · Nice' },
  { period: '2022 – 2023', degree: 'Licence — Administrateur Système et Réseau', school: 'CESI · Nice' },
  { period: '2020 – 2022', degree: 'DUT — Réseaux et Télécommunications', school: 'Université Côte d’Azur · Sophia Antipolis' },
];

const labs = [
  { status: 'En préparation', title: 'BTL1 — Blue Team Level 1', note: '', progress: 80 },
  { status: 'Actif', title: 'Wazuh Home-Lab', note: 'SIEM déployé · scénarios de détection actifs', progress: 100 },
  { status: 'En cours', title: 'TryHackMe — SOC Level 1', note: '', progress: 70 },
  { status: 'En cours', title: 'LetsDefend — Scénarios SOC', note: '', progress: 60 },
];

const sections = [
  { id: 'chronologie', label: 'Chronologie' },
  { id: 'arsenal', label: 'Arsenal' },
  { id: 'labs', label: 'Labs' },
  { id: 'conclusion', label: 'Contact' },
];

const idCard = [
  ['Rôle', 'SOC Analyst N1/N2'],
  ['Spécialité', 'IBM QRadar'],
  ['Cadre', 'ISO 27035 · ATT&CK'],
  ['Base', 'Vence · Télétravail ok'],
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f1ede2" />
    <title>Dorian Samtmann — SOC Analyst · Blue Team</title>
    <meta
      name="description"
      content="Dorian Samtmann, analyste SOC Blue Team spécialisé IBM QRadar : détection et réponse à incidents sur SI critique."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <!-- Enables scroll reveals; drops back to a static page if the main script never runs -->
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__reveal) document.documentElement.classList.remove('js');
      }, 2500);
    </script>
  </head>
  <body class="font-body text-ink antialiased">
    <div class="scanner" aria-hidden="true"></div>

    <!-- Document header strip -->
    <header class="sticky top-0 z-50 border-b border-ink bg-paper/90 backdrop-blur-sm">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 font-mono text-[11px] uppercase tracking-[0.14em] md:px-8">
        <a href="#top" class="font-semibold text-ink">D. Samtmann</a>
        <nav class="hidden items-center gap-6 md:flex" aria-label="Navigation principale">
          {
            sections.map((s, i) => (
              <a href={`#${s.id}`} data-nav={s.id} class="nav-link text-muted transition-colors hover:text-ink">
                <span class="text-stamp">§{String(i + 1).padStart(2, '0')}</span> {s.label}
              </a>
            ))
          }
        </nav>
        <a href={CV} download class="border border-ink px-3 py-1.5 font-semibold transition-colors hover:bg-ink hover:text-paper">
          CV.pdf ↓
        </a>
      </div>
      <div class="read-progress" aria-hidden="true"></div>
    </header>

    <main id="top" class="mx-auto max-w-6xl px-4 md:px-8">
      <!-- ───────── Cover ───────── -->
      <section class="relative pb-16 pt-10 md:pb-24 md:pt-14">
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule pb-3 font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
          <span class="print-in">Rapport d'analyse · Réf. DS-2026-001</span>
          <span class="print-in" style="animation-delay:.1s">TLP:CLEAR · Diffusion libre</span>
        </div>

        <div class="mt-10 grid gap-10 md:mt-14 md:grid-cols-12">
          <div class="md:col-span-8">
            <p class="print-in font-mono text-xs uppercase tracking-[0.2em] text-stamp" style="animation-delay:.2s">
              Objet de l'analyse
            </p>
            <h1 class="mt-3 font-display text-[clamp(3.4rem,11vw,8.5rem)] leading-[0.88] tracking-[-0.02em]">
              <span class="print-in block" style="animation-delay:.3s">Dorian</span>
              <em class="print-in block italic" style="animation-delay:.55s">Samtmann</em>
            </h1>
            <p class="print-in mt-8 max-w-xl text-lg leading-relaxed md:text-xl" style="animation-delay:.8s">
              Analyste SOC, Blue Team. Trois ans à lire des alertes QRadar sur un SI critique pour séparer le bruit
              de ce qui <span class="redact" tabindex="0" title="Survoler pour lire">ne devrait vraiment pas être là</span>.
            </p>
          </div>

          <!-- Identification card -->
          <aside class="thud relative md:col-span-4 md:pt-8">
            <dl class="print-in border border-ink bg-sheet font-mono text-[13px]" style="animation-delay:.9s">
              {
                idCard.map(([k, v]) => (
                  <div class="flex gap-3 border-b border-rule px-4 py-2.5 last:border-b-0">
                    <dt class="w-24 shrink-0 uppercase tracking-wider text-muted">{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))
              }
            </dl>
            <div class="pointer-events-none absolute -bottom-12 right-2 md:-bottom-14 md:-right-4">
              <span class="stamp text-lg md:text-xl">Disponible</span>
            </div>
          </aside>
        </div>

        <!-- Key indicators -->
        <div class="rv relative mt-20 md:mt-24" data-counters>
          <p class="st absolute -top-9 left-0 -rotate-2 font-hand text-2xl text-stamp md:-left-2" style="--d:700ms">à retenir ↓</p>
          <div class="draw h-px bg-ink"></div>
          <div class="grid grid-cols-2 md:grid-cols-4">
            {
              indicators.map((k, i) => (
                <div
                  class={`st px-1 py-6 md:px-5 ${i % 2 === 1 ? 'border-l border-rule pl-4' : ''} ${i >= 2 ? 'border-t border-rule md:border-t-0' : ''} ${i === 2 ? 'md:border-l md:pl-5' : ''}`}
                  style={`--d:${i * 120}ms`}
                >
                  <p class="font-display text-5xl leading-none md:text-6xl">
                    <span class={i === 0 ? 'marker' : ''} data-count={k.count} data-suffix={k.suffix}>
                      {k.value}
                    </span>
                  </p>
                  <p class="mt-3 max-w-[16ch] text-sm leading-snug text-muted">{k.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ───────── §01 Chronologie ───────── -->
      <section id="chronologie" class="scroll-mt-20 border-t border-ink py-16 md:grid md:grid-cols-12 md:gap-10 md:py-24">
        <div class="rv md:col-span-3">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-stamp">§ 01</p>
          <h2 class="mt-2 font-display text-5xl leading-none md:text-6xl">Chronologie</h2>
          <p class="mt-4 max-w-xs text-sm text-muted">Les faits, dans l'ordre. Chaque poste est traité comme un cas.</p>
        </div>

        <ol class="mt-10 md:col-span-9 md:mt-0">
          {
            experience.map((job, n) => (
              <li class="rv case relative grid gap-4 py-10 first:pt-0 md:grid-cols-9 md:gap-8">
                {n > 0 && <div class="draw absolute inset-x-0 top-0 h-px bg-rule" />}
                <div class="font-mono text-xs uppercase tracking-wider md:col-span-2">
                  <p class="case-ref text-muted transition-colors">{job.ref}</p>
                  <p class="mt-1 text-sm normal-case tracking-normal text-ink">{job.period}</p>
                  <p class="mt-3 inline-flex items-center gap-2">
                    <span
                      class={`inline-block h-2 w-2 rounded-full ${job.status === 'Ouvert' ? 'pulse bg-stamp' : 'border border-ink'}`}
                    />
                    Statut : {job.status}
                  </p>
                </div>

                <div class="md:col-span-7">
                  <h3 class="font-display text-3xl leading-tight md:text-4xl">
                    {job.title} <span class="italic text-muted">chez</span> {job.org}
                  </h3>
                  <p class="mt-1 font-mono text-xs uppercase tracking-wider text-muted">{job.place}</p>

                  <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Constatations</p>
                  <ol class="mt-2 space-y-2">
                    {job.bullets.map((b, i) => (
                      <li class="flex gap-4 border-b border-dotted border-rule pb-2 leading-relaxed">
                        <span class="st w-6 shrink-0 pt-0.5 font-mono text-xs text-muted" style={`--d:${250 + i * 110}ms`}>
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <span class="line" style={`--d:${300 + i * 110}ms`}>
                          {b}
                        </span>
                      </li>
                    ))}
                  </ol>

                  {job.stack.length > 0 && (
                    <>
                      <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.18em] text-muted">Outils</p>
                      <ul class="mt-3 flex flex-wrap gap-2">
                        {job.stack.map((t, i) => (
                          <li
                            class="st border border-ink bg-sheet px-2.5 py-1 font-mono text-xs"
                            style={`--d:${450 + job.bullets.length * 110 + i * 50}ms`}
                          >
                            {t}
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- ───────── §02 Arsenal ───────── -->
      <section id="arsenal" class="scroll-mt-20 border-t border-ink py-16 md:py-24">
        <div class="rv flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-stamp">§ 02</p>
            <h2 class="mt-2 font-display text-5xl leading-none md:text-6xl">Arsenal</h2>
          </div>
          <p class="max-w-sm text-sm text-muted">Disposé comme une matrice ATT&CK — sauf qu'ici, chaque colonne sert à défendre.</p>
        </div>

        <div class="rv mt-10 grid grid-cols-2 border-l border-t border-ink sm:grid-cols-3 lg:grid-cols-6">
          {
            skillGroups.map((g, c) => (
              <div class="border-b border-r border-ink">
                <p
                  class="st bg-ink px-3 py-2.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-paper"
                  style={`--d:${c * 70}ms`}
                >
                  {g.name}
                </p>
                <ul>
                  {g.items.map((item, r) => (
                    <li
                      class="st border-t border-rule px-3 py-2.5 text-sm transition-colors first:border-t-0 hover:bg-marker/60"
                      style={`--d:${c * 70 + (r + 1) * 90}ms`}
                    >
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <!-- Formation -->
        <div class="rv mt-16 md:grid md:grid-cols-12 md:gap-10">
          <h3 class="font-display text-3xl md:col-span-3">Formation</h3>
          <ul class="mt-6 md:col-span-9 md:mt-0">
            {
              formation.map((f, i) => (
                <li
                  class="st flex flex-col gap-1 border-b border-rule py-4 first:pt-0 sm:flex-row sm:items-baseline sm:gap-6"
                  style={`--d:${i * 120}ms`}
                >
                  <span class="w-28 shrink-0 font-mono text-xs text-muted">{f.period}</span>
                  <span class="flex-1">{f.degree}</span>
                  <span class="font-mono text-xs uppercase tracking-wider text-muted sm:text-right">{f.school}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ───────── §03 Labs ───────── -->
      <section id="labs" class="scroll-mt-20 border-t border-ink py-16 md:grid md:grid-cols-12 md:gap-10 md:py-24">
        <div class="rv md:col-span-3">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-stamp">§ 03</p>
          <h2 class="mt-2 font-display text-5xl leading-none md:text-6xl">
            Labs<br /><em class="italic">en cours</em>
          </h2>
          <p class="mt-4 max-w-xs text-sm text-muted">Certifications &amp; home-lab — les dossiers encore ouverts.</p>
        </div>

        <ul class="rv mt-10 space-y-8 md:col-span-9 md:mt-2">
          {
            labs.map((lab, i) => (
              <li class="st" style={`--d:${i * 140}ms`}>
                <div class="flex items-baseline gap-3">
                  <span class="text-lg">{lab.title}</span>
                  <span class="leader" aria-hidden="true" />
                  <span class={`font-mono text-xs uppercase tracking-wider ${lab.progress === 100 ? 'text-stamp' : 'text-muted'}`}>
                    {lab.status} · {lab.progress}%
                  </span>
                </div>
                <div
                  class="hatch-track mt-2"
                  role="progressbar"
                  aria-valuenow={lab.progress}
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-label={lab.title}
                >
                  <div class={`hatch-fill ${lab.progress === 100 ? 'is-done' : ''}`} style={`--p:${lab.progress}%`} />
                </div>
                {lab.note && <p class="mt-2 font-hand text-xl text-stamp">↳ {lab.note}</p>}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ───────── §04 Conclusion ───────── -->
      <section id="conclusion" class="rv scroll-mt-20 border-t border-ink py-16 md:py-24">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-stamp">§ 04 — Conclusion de l'analyste</p>
        <p class="mt-6 max-w-4xl font-display text-[clamp(2.4rem,6vw,4.75rem)] leading-[1.02]">
          Profil <span class="marker">opérationnel</span>, disponible pour un poste SOC <em class="italic">N1/N2</em>.
        </p>
        <p class="mt-6 max-w-xl text-lg text-muted">Le reste se raconte mieux de vive voix.</p>

        <div class="mt-12 grid gap-10 md:grid-cols-12">
          <ul class="font-mono text-sm md:col-span-7">
            {
              contacts.map((c, i) => (
                <li class="st" style={`--d:${300 + i * 90}ms`}>
                  <a
                    href={c.href}
                    target={c.href.startsWith('http') ? '_blank' : undefined}
                    rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="group flex items-baseline gap-3 border-b border-rule py-3 transition-colors hover:border-ink"
                  >
                    <span class="w-20 shrink-0 text-xs uppercase tracking-wider text-muted">{c.label}</span>
                    <span class="break-all group-hover:underline group-hover:decoration-stamp group-hover:decoration-2 group-hover:underline-offset-4">
                      {c.value}
                    </span>
                    <span class="ml-auto text-muted transition-transform group-hover:translate-x-1 group-hover:text-stamp">→</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="flex flex-col justify-between gap-8 md:col-span-5 md:pl-6">
            <a
              href={CV}
              download
              class="group flex items-center justify-between border-2 border-ink bg-ink px-5 py-4 font-mono text-sm uppercase tracking-wider text-paper transition-colors hover:bg-transparent hover:text-ink"
            >
              Télécharger le dossier complet
              <span class="transition-transform group-hover:translate-y-0.5">↓</span>
            </a>
            <div>
              <p class="sig font-hand text-4xl leading-none">Dorian S.</p>
              <p class="mt-2 border-t border-ink pt-2 font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
                Signature de l'analyste · Vence, 2026
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-ink">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 font-mono text-[11px] uppercase tracking-[0.14em] text-muted sm:flex-row sm:justify-between md:px-8">
        <span>Fin du rapport · portfolio-dorian.s-t-m.fr</span>
        <a href="https://cybersmartdesign.fr" class="transition-colors hover:text-ink">Mise en page : cybersmartdesign.fr</a>
      </div>
    </footer>

    <script is:inline>
      (function () {
        window.__reveal = true;
        var root = document.documentElement;
        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var blocks = document.querySelectorAll('.rv');

        function countUp(el) {
          var target = +el.dataset.count;
          var suffix = el.dataset.suffix || '';
          if (still || target < 10) return;
          var start = performance.now();
          var dur = 1400;
          (function tick(now) {
            var t = Math.min(1, (now - start) / dur);
            var v = Math.round(target * (1 - Math.pow(1 - t, 4)));
            el.textContent = String(v).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + suffix;
            if (t < 1) requestAnimationFrame(tick);
          })(start);
        }

        function reveal(el) {
          el.classList.add('is-in');
          if (el.hasAttribute('data-counters')) el.querySelectorAll('[data-count]').forEach(countUp);
        }

        if (still || !('IntersectionObserver' in window)) {
          blocks.forEach(reveal);
        } else {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  reveal(e.target);
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: '0px 0px -12% 0px' }
          );
          blocks.forEach(function (b) {
            io.observe(b);
          });
        }

        // Reading progress + active section in the nav
        var navLinks = document.querySelectorAll('[data-nav]');
        var sections = Array.prototype.map.call(navLinks, function (a) {
          return document.getElementById(a.dataset.nav);
        });
        var queued = false;
        function onScroll() {
          queued = false;
          var max = root.scrollHeight - innerHeight;
          root.style.setProperty('--read', max > 0 ? (scrollY / max).toFixed(4) : '0');
          var current = -1;
          sections.forEach(function (s, i) {
            if (s && s.getBoundingClientRect().top < innerHeight * 0.4) current = i;
          });
          navLinks.forEach(function (a, i) {
            a.setAttribute('aria-current', i === current ? 'true' : 'false');
          });
        }
        addEventListener(
          'scroll',
          function () {
            if (!queued) {
              queued = true;
              requestAnimationFrame(onScroll);
            }
          },
          { passive: true }
        );
        onScroll();
      })();
    </script>
  </body>
</html>
